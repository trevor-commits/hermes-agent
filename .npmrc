# Keep the package-age floor. Unsupported exclusion keys are not effective controls.
engine-strict=true
min-release-age=14
# electron-builder 26.16.x chain includes high-sev fixes (app-builder-lib/builder-util/dmg-builder/js-yaml). remove when > 2wks old (rel 2026-09-02..09-07)
min-release-age-exclude[]=electron-builder
min-release-age-exclude[]=app-builder-lib
min-release-age-exclude[]=builder-util
min-release-age-exclude[]=dmg-builder
min-release-age-exclude[]=electron-publish
min-release-age-exclude[]=electron-builder-squirrel-windows
